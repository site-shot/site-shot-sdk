{
  "name": "site-shot-sdk",
  "version": "0.2.2",
  "description": "Website screenshot API SDK for Node.js — official Site-Shot client: capture website screenshots (full-page, PNG/JPEG/WebP) in a real Chromium browser with ad & cookie-banner removal; free plan 100 captures/mo, country proxies on paid plans. Zero runtime dependencies.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --target node18 --clean",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test",
    "smoke": "node scripts/smoke.mjs",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "keywords": [
    "screenshot",
    "website screenshot",
    "screenshot api",
    "website screenshot api",
    "screenshot sdk",
    "node screenshot",
    "full page screenshot",
    "url to image",
    "screenshot-api",
    "website-screenshot",
    "site-shot",
    "sdk",
    "api-client",
    "full-page-screenshot",
    "url-to-image",
    "web-capture"
  ],
  "homepage": "https://www.site-shot.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/site-shot/site-shot-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/site-shot/site-shot-sdk/issues"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  }
}
